# Discord bot-token fra https://discord.com/developers/applications
DISCORD_TOKEN=din_bot_token_her

# Application (Client) ID fra Developer Portal -> General Information
CLIENT_ID=din_application_id_her

# (Valgfrit) Server-ID til hurtig deploy af slash commands under udvikling.
# Lad stå tomt for at deploye globalt (kan tage op til 1 time).
GUILD_ID=

# (Valgfrit) Sæt til "false" for at slå auto-registrering af slash commands ved opstart fra.
# Default: kommandoer registreres automatisk hver gang botten starter.
DEPLOY_ON_STARTUP=true

# (Valgfrit) Custom emoji der vises foran bot-beskeder.
# Format for statisk: <:navn:id>   – animeret: <a:navn:id>
# Eksempel: <:mathiasgs:1502605641515143369>
BOT_EMOJI=

# (Valgfrit) OpenAI – tilføjer en "fun fact" på /voicerapport
OPENAI_API_KEY=
# (Valgfrit) Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# (Valgfrit) Daglig aften-review: DM kl. 06:00 dansk tid med dagen før
# Default: tændt. Sæt til false for at slå fra.
VOICE_DAILY_REPORT=true
VOICE_DAILY_HOUR=6
VOICE_DAILY_TONE=roast
